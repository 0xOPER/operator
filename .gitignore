# Default-deny: a top-level path is tracked only if it's named here, and a file only if keep-list names it.
/*
!/.github/
!/assets/
!/bin/
!/docs/
!/profiles/
!/config/
!/scripts/
!/test/
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/INTERFACES.md
!/README.md
!/SECURITY.md
!/VERSION
!/keep-list
!/keep-list.private
!/forward-port.tsv
!/LIMITATIONS
!/CLAIMS.md
!/claims-rekor.json
!/claims.pub
!/LICENSE
!/Dockerfile
__pycache__/
*.pyc
